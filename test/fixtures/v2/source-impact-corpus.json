      "bindings": [
        {"id": "a", "subject": "scenario-a", "repositoryId": "repo", "pathGlobs": ["lib/a.dart"], "dependsOn": []},
        {"id": "b", "subject": "scenario-b", "repositoryId": "repo", "pathGlobs": ["lib/b.dart"], "dependsOn": []}
      ],
      "expectedImpacted": ["a"]
