{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jantunesmessias/abel/schemas/evidence/app-adapter-capture-command",
  "title": "AppAdapterCaptureCommand",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "requestId",
    "sessionId",
    "format",
    "uploadUri",
    "expiresAt",
    "maxBytes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "AppAdapterCaptureCommand" },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" },
    "sessionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" },
    "format": { "const": "png" },
    "uploadUri": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "expiresAt": { "type": "string", "format": "date-time" },
    "maxBytes": { "type": "integer", "minimum": 1024, "maximum": 33554432 }
  }
}
