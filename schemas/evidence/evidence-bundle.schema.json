{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jantunesmessias/abel/schemas/evidence/evidence-bundle",
  "title": "Portable bundle and seal",
  "oneOf": [{"$ref": "#/$defs/manifest"}, {"$ref": "#/$defs/seal"}],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "size", "mediaType"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
        "digest": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 0},
        "mediaType": {"type": "string", "minLength": 1}
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "releaseDigest", "releaseBundleDigest", "entries", "attestation", "digest"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "EvidenceBundleManifest"},
        "releaseDigest": {"$ref": "#/$defs/digest"},
        "releaseBundleDigest": {"$ref": "#/$defs/digest"},
        "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
        "attestation": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"const": "absent"}}},
            {"type": "object", "additionalProperties": false, "required": ["status", "digest"], "properties": {"status": {"const": "present"}, "digest": {"$ref": "#/$defs/digest"}}}
          ]
        },
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "releaseDigest", "bundleArchiveDigest", "impactPlanDigest", "sourceSnapshotDigests", "policyId", "digest"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "ReleaseSeal"},
        "releaseDigest": {"$ref": "#/$defs/digest"},
        "bundleArchiveDigest": {"$ref": "#/$defs/digest"},
        "impactPlanDigest": {"$ref": "#/$defs/digest"},
        "sourceSnapshotDigests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
        "policyId": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
