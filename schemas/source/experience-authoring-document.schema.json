        "y": {"$ref": "#/$defs/coordinate"},
        "width": {"$ref": "#/$defs/extent"},
        "height": {"$ref": "#/$defs/extent"},
        "groupId": {"$ref": "#/$defs/opaqueId"},
        "laneId": {"$ref": "#/$defs/opaqueId"}
      },
      "additionalProperties": false
    },
    "region": {
      "type": "object",
      "required": ["id", "title", "x", "y", "width", "height"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "title": {"$ref": "#/$defs/boundedText"},
        "x": {"$ref": "#/$defs/coordinate"},
        "y": {"$ref": "#/$defs/coordinate"},
        "width": {"$ref": "#/$defs/extent"},
        "height": {"$ref": "#/$defs/extent"}
      },
      "additionalProperties": false
    },
    "annotation": {
      "type": "object",
      "required": ["id", "text", "x", "y", "width", "height"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "text": {"type": "string", "minLength": 1, "maxLength": 16384},
        "x": {"$ref": "#/$defs/coordinate"},
        "y": {"$ref": "#/$defs/coordinate"},
        "width": {"$ref": "#/$defs/extent"},
        "height": {"$ref": "#/$defs/extent"}
      },
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": {"$ref": "#/$defs/coordinate"},
        "y": {"$ref": "#/$defs/coordinate"},
        "zoom": {"type": "number", "minimum": 0.05, "maximum": 64}
      },
      "additionalProperties": false
    },
    "layoutSpec": {
      "type": "object",
      "required": [
        "projectionId",
        "nodeFrames",
        "groups",
        "lanes",
        "annotations",
        "camera"
      ],
      "properties": {
        "projectionId": {"$ref": "#/$defs/opaqueId"},
        "nodeFrames": {
          "type": "array",
          "maxItems": 500000,
          "items": {"$ref": "#/$defs/nodeFrame"}
        },
        "groups": {
          "type": "array",
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/region"}
        },
        "lanes": {
          "type": "array",
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/region"}
        },
        "annotations": {
          "type": "array",
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/annotation"}
        },
        "camera": {"$ref": "#/$defs/camera"}
      },
      "additionalProperties": false
    }
  }
}
