{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devex.example/schemas/v1/plugin-manifest.schema.json",
  "title": "DevExKit out-of-process plugin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "executable", "coreCompatibility", "protocolVersions", "capabilities"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "PluginManifest"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "executable": {"type": "string", "minLength": 1},
    "coreCompatibility": {"type": "string", "pattern": "^\\^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "protocolVersions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "effect"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
          "effect": {"enum": ["query", "ephemeral", "authoring", "infrastructure", "decision"]}
        }
      }
    }
  }
}
