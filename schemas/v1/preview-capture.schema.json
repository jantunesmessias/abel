{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devex:schema:preview-capture:v1",
  "title": "DevExKit AutoPreview contracts v1",
  "oneOf": [
    {"$ref": "#/$defs/variant"},
    {"$ref": "#/$defs/previewDescriptor"},
    {"$ref": "#/$defs/previewManifest"},
    {"$ref": "#/$defs/previewCaptureManifest"},
    {"$ref": "#/$defs/previewCaptureReport"}
  ],
  "$defs": {
    "opaqueId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utcTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3,6})?Z$"
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "applicationId",
        "logicalWidth",
        "logicalHeight",
        "devicePixelRatio",
        "brightness",
        "localeTag",
        "textScaleFactor",
        "digest"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "Variant"},
        "id": {"$ref": "#/$defs/opaqueId"},
        "applicationId": {"$ref": "#/$defs/opaqueId"},
        "logicalWidth": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000},
        "logicalHeight": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000},
        "devicePixelRatio": {"type": "number", "exclusiveMinimum": 0, "maximum": 8},
        "brightness": {"enum": ["light", "dark"]},
        "localeTag": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
        },
        "textScaleFactor": {"type": "number", "minimum": 0.5, "maximum": 4},
        "themeId": {"$ref": "#/$defs/opaqueId"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "previewDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "scenarioId",
        "variant",
        "sourceUri",
        "declarationName",
        "capturePolicyId",
        "digest"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "PreviewDescriptor"},
        "id": {"$ref": "#/$defs/opaqueId"},
        "scenarioId": {"$ref": "#/$defs/opaqueId"},
        "variant": {"$ref": "#/$defs/variant"},
        "sourceUri": {
          "type": "string",
          "pattern": "^(?:package|file):[^\\s]+$"
        },
        "declarationName": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "capturePolicyId": {"$ref": "#/$defs/opaqueId"},
        "fixtureRef": {"$ref": "#/$defs/opaqueId"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "previewManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "catalogDigest",
        "flutterCompatibility",
        "descriptors",
        "digest"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "PreviewManifest"},
        "catalogDigest": {"$ref": "#/$defs/digest"},
        "flutterCompatibility": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.x$"
        },
        "descriptors": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/previewDescriptor"}
        },
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {"$ref": "#/$defs/opaqueId"},
        "severity": {"enum": ["info", "warning", "error"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "captureItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previewId",
        "scenarioId",
        "variantId",
        "descriptorDigest",
        "captureKey",
        "status",
        "diagnostics"
      ],
      "properties": {
        "previewId": {"$ref": "#/$defs/opaqueId"},
        "scenarioId": {"$ref": "#/$defs/opaqueId"},
        "variantId": {"$ref": "#/$defs/opaqueId"},
        "descriptorDigest": {"$ref": "#/$defs/digest"},
        "captureKey": {"$ref": "#/$defs/digest"},
        "status": {
          "enum": ["collected", "invalid", "failed", "unsupported", "policyDenied"]
        },
        "artifactDigest": {"$ref": "#/$defs/digest"},
        "pixelDigest": {"$ref": "#/$defs/digest"},
        "pixelWidth": {"type": "integer", "minimum": 1},
        "pixelHeight": {"type": "integer", "minimum": 1},
        "diagnostics": {
          "type": "array",
          "items": {"$ref": "#/$defs/diagnostic"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "collected"}}},
          "then": {
            "required": ["artifactDigest", "pixelDigest", "pixelWidth", "pixelHeight"]
          },
          "else": {
            "properties": {
              "artifactDigest": false,
              "pixelDigest": false,
              "pixelWidth": false,
              "pixelHeight": false
            }
          }
        }
      ]
    },
    "previewCaptureManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "previewManifestDigest",
        "renderer",
        "toolchainDigest",
        "executionFingerprintDigest",
        "items",
        "digest"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "PreviewCaptureManifest"},
        "previewManifestDigest": {"$ref": "#/$defs/digest"},
        "renderer": {"$ref": "#/$defs/opaqueId"},
        "toolchainDigest": {"$ref": "#/$defs/digest"},
        "executionFingerprintDigest": {"$ref": "#/$defs/digest"},
        "items": {
          "type": "array",
          "items": {"$ref": "#/$defs/captureItem"}
        },
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "previewCaptureReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "captureManifestDigest",
        "startedAt",
        "completedAt",
        "totalItems",
        "collectedItems",
        "failedItems",
        "diagnostics",
        "digest"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "PreviewCaptureReport"},
        "captureManifestDigest": {"$ref": "#/$defs/digest"},
        "startedAt": {"$ref": "#/$defs/utcTime"},
        "completedAt": {"$ref": "#/$defs/utcTime"},
        "totalItems": {"type": "integer", "minimum": 0},
        "collectedItems": {"type": "integer", "minimum": 0},
        "failedItems": {"type": "integer", "minimum": 0},
        "diagnostics": {
          "type": "array",
          "items": {"$ref": "#/$defs/diagnostic"}
        },
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
