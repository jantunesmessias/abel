{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devexkit.local/schemas/v1/containment-report.schema.json",
  "title": "TargetContainmentReport v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "targetId",
    "adapterId",
    "platform",
    "executedAt",
    "networkContainment",
    "probes",
    "digest"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "TargetContainmentReport"},
    "targetId": {"type": "string", "minLength": 1},
    "adapterId": {"type": "string", "minLength": 1},
    "platform": {"enum": ["web", "androidEmulator"]},
    "executedAt": {"type": "string", "format": "date-time"},
    "networkContainment": {"enum": ["gatewayOnly", "targetEnforced"]},
    "probes": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["kind", "passed", "detailCode"],
        "properties": {
          "kind": {"enum": ["gatewayReachable", "directEgressDenied"]},
          "passed": {"type": "boolean"},
          "detailCode": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
          }
        },
        "additionalProperties": false
      }
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
