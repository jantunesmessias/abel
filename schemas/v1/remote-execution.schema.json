{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devex.example/schemas/v1/remote-execution.schema.json",
  "title": "DevExKit Remote Execution v1",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/plan"},
    {"$ref": "#/$defs/run"},
    {"$ref": "#/$defs/artifactManifest"},
    {"$ref": "#/$defs/containmentReport"},
    {"$ref": "#/$defs/lease"},
    {"$ref": "#/$defs/sessionTicket"}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "utc": {"type": "string", "pattern": "Z$"},
    "target": {"enum": ["web", "androidEmulator"]},
    "mode": {"enum": ["batch", "interactive"]},
    "interactiveTransport": {"enum": ["webDirect", "scrcpyH264Control", "periodicScreenshotReadOnly", "none"]},
    "artifactInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "digest", "size", "mediaType"],
      "properties": {
        "role": {"enum": ["webBuild", "androidApk", "interactionScript", "gatewayPlan"]},
        "digest": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 1, "maximum": 2147483648},
        "mediaType": {"type": "string", "minLength": 1, "maxLength": 255}
      }
    },
    "deviceImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "imageDigest", "apiLevel", "abi", "renderer", "kvmRequired"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "imageDigest": {"$ref": "#/$defs/digest"},
        "apiLevel": {"type": "integer", "minimum": 21, "maximum": 100},
        "abi": {"type": "string", "minLength": 1, "maxLength": 64},
        "renderer": {"type": "string", "minLength": 1, "maxLength": 64},
        "kvmRequired": {"type": "boolean"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"mode": {"const": "batch"}}, "required": ["mode"]}, "then": {"properties": {"interactiveTransport": {"const": "none"}}}},
        {"if": {"properties": {"mode": {"const": "interactive"}, "target": {"const": "web"}}, "required": ["mode", "target"]}, "then": {"properties": {"interactiveTransport": {"const": "webDirect"}}}},
        {"if": {"properties": {"mode": {"const": "interactive"}, "target": {"const": "androidEmulator"}}, "required": ["mode", "target"]}, "then": {"properties": {"interactiveTransport": {"enum": ["scrcpyH264Control", "periodicScreenshotReadOnly"]}}}}
      ],
      "required": ["schemaVersion", "kind", "tenantId", "id", "workspaceId", "requestedBy", "target", "mode", "interactiveTransport", "priority", "maximumDurationSeconds", "artifacts", "requestedAt"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "RemoteExecutionRequest"},
        "tenantId": {"$ref": "#/$defs/id"},
        "id": {"$ref": "#/$defs/id"},
        "workspaceId": {"$ref": "#/$defs/id"},
        "requestedBy": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/target"},
        "mode": {"$ref": "#/$defs/mode"},
        "interactiveTransport": {"$ref": "#/$defs/interactiveTransport"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 100},
        "maximumDurationSeconds": {"type": "integer", "minimum": 30, "maximum": 3600},
        "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactInput"}},
        "requestedAt": {"$ref": "#/$defs/utc"}
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"mode": {"const": "batch"}}, "required": ["mode"]}, "then": {"properties": {"interactiveTransport": {"const": "none"}}}},
        {"if": {"properties": {"mode": {"const": "interactive"}, "target": {"const": "web"}}, "required": ["mode", "target"]}, "then": {"properties": {"interactiveTransport": {"const": "webDirect"}}}},
        {"if": {"properties": {"mode": {"const": "interactive"}, "target": {"const": "androidEmulator"}}, "required": ["mode", "target"]}, "then": {"properties": {"interactiveTransport": {"enum": ["scrcpyH264Control", "periodicScreenshotReadOnly"]}}}}
      ],
      "required": ["schemaVersion", "kind", "tenantId", "runId", "requestDigest", "target", "mode", "interactiveTransport", "artifacts", "executionFingerprintDigest", "containmentPolicyDigest", "issuedAt", "expiresAt", "nonce"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "RemoteExecutionPlan"},
        "tenantId": {"$ref": "#/$defs/id"},
        "runId": {"$ref": "#/$defs/id"},
        "requestDigest": {"$ref": "#/$defs/digest"},
        "target": {"$ref": "#/$defs/target"},
        "mode": {"$ref": "#/$defs/mode"},
        "interactiveTransport": {"$ref": "#/$defs/interactiveTransport"},
        "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactInput"}},
        "executionFingerprintDigest": {"$ref": "#/$defs/digest"},
        "containmentPolicyDigest": {"$ref": "#/$defs/digest"},
        "issuedAt": {"$ref": "#/$defs/utc"},
        "expiresAt": {"$ref": "#/$defs/utc"},
        "nonce": {"$ref": "#/$defs/id"},
        "deviceImage": {"$ref": "#/$defs/deviceImage"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "tenantId", "id", "requestDigest", "planDigest", "target", "mode", "state", "attempt", "createdAt", "updatedAt"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "RemoteRun"},
        "tenantId": {"$ref": "#/$defs/id"},
        "id": {"$ref": "#/$defs/id"},
        "requestDigest": {"$ref": "#/$defs/digest"},
        "planDigest": {"$ref": "#/$defs/digest"},
        "target": {"$ref": "#/$defs/target"},
        "mode": {"$ref": "#/$defs/mode"},
        "state": {"enum": ["queued", "scheduled", "provisioning", "running", "uploading", "succeeded", "failed", "cancelled", "unknown"]},
        "attempt": {"type": "integer", "minimum": 0, "maximum": 10},
        "createdAt": {"$ref": "#/$defs/utc"},
        "updatedAt": {"$ref": "#/$defs/utc"},
        "workerId": {"$ref": "#/$defs/id"},
        "failureCode": {"type": "string", "minLength": 1}
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "runId", "workerId", "tokenId", "generation", "acquiredAt", "heartbeatAt", "expiresAt"],
      "properties": {
        "tenantId": {"$ref": "#/$defs/id"},
        "runId": {"$ref": "#/$defs/id"},
        "workerId": {"$ref": "#/$defs/id"},
        "tokenId": {"$ref": "#/$defs/id"},
        "generation": {"type": "integer", "minimum": 1},
        "acquiredAt": {"$ref": "#/$defs/utc"},
        "heartbeatAt": {"$ref": "#/$defs/utc"},
        "expiresAt": {"$ref": "#/$defs/utc"}
      }
    },
    "sessionTicket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "tenantId", "runId", "principalId", "role", "allowedTransports", "issuedAt", "expiresAt", "nonce"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "RemoteSessionTicket"},
        "tenantId": {"$ref": "#/$defs/id"},
        "runId": {"$ref": "#/$defs/id"},
        "principalId": {"$ref": "#/$defs/id"},
        "role": {"const": "viewer"},
        "allowedTransports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["webDirect", "scrcpyH264Control", "periodicScreenshotReadOnly"]}
        },
        "issuedAt": {"$ref": "#/$defs/utc"},
        "expiresAt": {"$ref": "#/$defs/utc"},
        "nonce": {"$ref": "#/$defs/id"}
      }
    },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "digest", "size", "mediaType", "classification", "objectKey"],
      "properties": {
        "tenantId": {"$ref": "#/$defs/id"},
        "digest": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 0},
        "mediaType": {"type": "string", "minLength": 1},
        "classification": {"enum": ["public", "internal", "sensitive"]},
        "objectKey": {"type": "string", "minLength": 1}
      }
    },
    "artifactManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "tenantId", "runId", "executionFingerprintDigest", "interactiveTransport", "artifacts", "createdAt"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "RemoteArtifactManifest"},
        "tenantId": {"$ref": "#/$defs/id"},
        "runId": {"$ref": "#/$defs/id"},
        "executionFingerprintDigest": {"$ref": "#/$defs/digest"},
        "interactiveTransport": {"$ref": "#/$defs/interactiveTransport"},
        "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/blob"}},
        "createdAt": {"$ref": "#/$defs/utc"}
      }
    },
    "containmentReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "tenantId", "runId", "namespace", "serviceAccount", "podSecurityProfile", "defaultDenyEgress", "allowedEndpointClasses", "ephemeralStorageWiped", "leaseRevoked", "observedAt"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "RemoteContainmentReport"},
        "tenantId": {"$ref": "#/$defs/id"},
        "runId": {"$ref": "#/$defs/id"},
        "namespace": {"$ref": "#/$defs/id"},
        "serviceAccount": {"$ref": "#/$defs/id"},
        "podSecurityProfile": {"enum": ["restricted", "android-kvm-minimal"]},
        "defaultDenyEgress": {"const": true},
        "allowedEndpointClasses": {"type": "array", "uniqueItems": true, "items": {"enum": ["gateway", "artifact", "control", "dns"]}},
        "ephemeralStorageWiped": {"type": "boolean"},
        "leaseRevoked": {"type": "boolean"},
        "observedAt": {"$ref": "#/$defs/utc"}
      }
    }
  }
}
