{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devex.example/schemas/v1/android-evidence.schema.json",
  "title": "DevExKit Android evidence v1",
  "oneOf": [
    {"$ref": "#/$defs/manifest"},
    {"$ref": "#/$defs/visualPolicy"},
    {"$ref": "#/$defs/semanticPolicy"},
    {"$ref": "#/$defs/comparisonReport"}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageDescriptor", "imageDigest", "apiLevel", "abi", "renderer", "locale", "timezone", "toolchain"],
      "properties": {
        "imageDescriptor": {"type": "string", "minLength": 1, "maxLength": 512},
        "imageDigest": {"$ref": "#/$defs/digest"},
        "apiLevel": {"type": "integer", "minimum": 21, "maximum": 999},
        "abi": {"type": "string", "pattern": "^[a-z0-9_]{2,32}$"},
        "renderer": {"type": "string", "minLength": 1, "maxLength": 512},
        "locale": {"type": "string", "minLength": 1, "maxLength": 512},
        "timezone": {"type": "string", "minLength": 1, "maxLength": 512},
        "toolchain": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 512}}
      }
    },
    "observation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "status", "detailCode", "artifactDigest"],
          "properties": {
            "role": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{1,127}$"},
            "status": {"const": "collected"},
            "detailCode": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$"},
            "artifactDigest": {"$ref": "#/$defs/digest"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "status", "detailCode"],
          "properties": {
            "role": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{1,127}$"},
            "status": {"enum": ["unavailable", "failed", "policyDenied"]},
            "detailCode": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$"}
          }
        }
      ]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "correlationId", "targetId", "runtimeFidelity", "environment", "containmentReportDigest", "collectedAt", "syntheticDataConfirmed", "observations", "digest"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "AndroidEvidenceManifest"},
        "correlationId": {"type": "string", "pattern": "^[a-zA-Z0-9._-]{8,128}$"},
        "targetId": {"type": "string", "minLength": 1},
        "runtimeFidelity": {"const": "hostNative"},
        "environment": {"$ref": "#/$defs/environment"},
        "containmentReportDigest": {"$ref": "#/$defs/digest"},
        "collectedAt": {"type": "string", "format": "date-time"},
        "syntheticDataConfirmed": {"type": "boolean"},
        "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "visualPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "id", "maxChannelDelta", "maxChangedPixelRatio"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "VisualComparisonPolicy"},
        "id": {"type": "string", "minLength": 1},
        "maxChannelDelta": {"type": "integer", "minimum": 0, "maximum": 255},
        "maxChangedPixelRatio": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "semanticPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "id", "maxChangedNodes", "ignoreBounds"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "SemanticComparisonPolicy"},
        "id": {"type": "string", "minLength": 1},
        "maxChangedNodes": {"type": "integer", "minimum": 0},
        "ignoreBounds": {"type": "boolean"}
      }
    },
    "comparisonReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "comparisonKind", "expectedDigest", "actualDigest", "policyDigest", "passed", "comparedUnits", "changedUnits", "metrics", "digest"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "EvidenceComparisonReport"},
        "comparisonKind": {"enum": ["visual", "semantic"]},
        "expectedDigest": {"$ref": "#/$defs/digest"},
        "actualDigest": {"$ref": "#/$defs/digest"},
        "policyDigest": {"$ref": "#/$defs/digest"},
        "passed": {"type": "boolean"},
        "comparedUnits": {"type": "integer", "minimum": 0},
        "changedUnits": {"type": "integer", "minimum": 0},
        "metrics": {"type": "object"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
