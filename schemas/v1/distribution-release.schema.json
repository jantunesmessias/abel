{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devexkit.local/schemas/v1/distribution-release.schema.json",
  "title": "DistributionReleaseManifest v1",
  "type": "object",
  "required": ["schemaVersion", "kind", "distribution", "releaseVersion", "coreVersion", "platform", "entrypoints", "commandAliases", "files", "digest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "DistributionReleaseManifest"},
    "distribution": {"type": "object"},
    "releaseVersion": {"$ref": "#/$defs/semver"},
    "coreVersion": {"$ref": "#/$defs/semver"},
    "platform": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "entrypoints": {
      "type": "object",
      "required": ["cli", "host", "gateway", "studio"],
      "properties": {
        "cli": {"$ref": "#/$defs/path"},
        "host": {"$ref": "#/$defs/path"},
        "gateway": {"$ref": "#/$defs/path"},
        "studio": {"$ref": "#/$defs/path"}
      },
      "additionalProperties": false
    },
    "commandAliases": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]{0,63}$"},
      "additionalProperties": {"$ref": "#/$defs/path"}
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "digest", "size", "executable", "role"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "digest": {"$ref": "#/$defs/digest"},
          "size": {"type": "integer", "minimum": 0},
          "executable": {"type": "boolean"},
          "role": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"}
  },
  "additionalProperties": false
}
