{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devex:schema:session-runtime:v1",
  "title": "DevExKit Session runtime documents v1",
  "oneOf": [
    {"$ref": "#/$defs/session"},
    {"$ref": "#/$defs/checkpoint"}
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "opaqueId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "runtimeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._:-]{0,127}$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "operations"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "version": {"type": "integer", "minimum": 1},
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaqueId"}
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "platform", "origin", "capabilities"],
      "properties": {
        "id": {"$ref": "#/$defs/runtimeId"},
        "platform": {"enum": ["web", "androidEmulator"]},
        "origin": {
          "type": "string",
          "pattern": "^https?://[^/?#@]+/?$"
        },
        "capabilities": {
          "type": "array",
          "items": {"$ref": "#/$defs/capability"}
        }
      }
    },
    "traceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "recordedAt", "event", "data"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "recordedAt": {"type": "string", "format": "date-time"},
        "event": {"$ref": "#/$defs/opaqueId"},
        "data": {"type": "object"}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "sequence",
        "recordedAt",
        "reason",
        "digest"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "Checkpoint"},
        "sequence": {"type": "integer", "minimum": 0},
        "recordedAt": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "launchProfileId",
        "state",
        "createdAt",
        "updatedAt",
        "trace",
        "digest"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "Session"},
        "id": {"$ref": "#/$defs/runtimeId"},
        "launchProfileId": {"$ref": "#/$defs/opaqueId"},
        "state": {
          "enum": [
            "created",
            "starting",
            "ready",
            "resetting",
            "stopping",
            "stopped",
            "cancelled",
            "failed"
          ]
        },
        "createdAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"},
        "trace": {
          "type": "array",
          "items": {"$ref": "#/$defs/traceEntry"}
        },
        "target": {"$ref": "#/$defs/target"},
        "terminalReason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "digest": {"$ref": "#/$defs/digest"}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "failed"}}},
          "then": {"required": ["terminalReason"]}
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "created",
                  "starting",
                  "ready",
                  "resetting",
                  "stopping"
                ]
              }
            }
          },
          "then": {"not": {"required": ["terminalReason"]}}
        }
      ]
    }
  }
}
