{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jantunesmessias/abel/schemas/runtime/android-lifecycle-report",
  "type": "object",
  "required": ["schemaVersion", "operation", "mode", "changed", "verified", "actions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "operation": {
      "enum": ["discover", "bootstrap", "update", "remove", "verify", "install", "launch", "reset", "capture", "start", "stop"]
    },
    "mode": {"enum": ["inspect", "dryRun", "apply"]},
    "changed": {"type": "boolean"},
    "verified": {"type": "boolean"},
    "actions": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "target": {
      "type": "object",
      "required": ["schemaVersion", "serial", "avdName", "apiLevel", "abi", "ownership", "capabilities"],
      "properties": {
        "schemaVersion": {"const": 1},
        "serial": {"type": "string", "pattern": "^emulator-[0-9]{4,5}$"},
        "avdName": {"type": "string", "minLength": 1, "maxLength": 128},
        "apiLevel": {"type": "integer", "minimum": 21, "maximum": 999},
        "abi": {"type": "string", "pattern": "^[a-z0-9_]{2,32}$"},
        "ownership": {"enum": ["attached", "managed"]},
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{1,63}$"}
        }
      },
      "unevaluatedProperties": false
    },
    "pairing": {
      "type": "object",
      "required": ["strategy", "hostPort", "targetPort", "tls", "targetOrigin"],
      "properties": {
        "strategy": {"enum": ["adbReverse", "emulatorHostAlias"]},
        "hostPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "targetPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "tls": {"type": "boolean"},
        "targetOrigin": {"type": "string", "pattern": "^https?://(127\\.0\\.0\\.1|10\\.0\\.2\\.2):[0-9]+$"}
      },
      "unevaluatedProperties": false
    },
    "artifactDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "unevaluatedProperties": false
}
