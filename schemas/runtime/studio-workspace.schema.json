{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jantunesmessias/abel/schemas/runtime/studio-workspace",
  "title": "Studio workspace contracts",
  "oneOf": [
    {"$ref": "#/$defs/resourceHandle"},
    {"$ref": "#/$defs/variantManifest"},
    {"$ref": "#/$defs/visualEvidenceProjection"},
    {"$ref": "#/$defs/workspaceSnapshot"}
  ],
  "$defs": {
    "opaqueId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utcTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3,6})?Z$"
    },
    "resourceHandle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "digest", "mediaType", "size", "purpose", "expiresAt"],
      "properties": {
        "uri": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^https?://[^/?#]+/resources/[A-Za-z0-9_-]{32,}$"
        },
        "digest": {"$ref": "#/$defs/digest"},
        "mediaType": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$"
        },
        "size": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "purpose": {"$ref": "#/$defs/opaqueId"},
        "expiresAt": {"$ref": "#/$defs/utcTime"}
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "applicationId",
        "logicalWidth",
        "logicalHeight",
        "devicePixelRatio",
        "brightness",
        "localeTag",
        "textScaleFactor",
        "digest"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "Variant"},
        "id": {"$ref": "#/$defs/opaqueId"},
        "applicationId": {"$ref": "#/$defs/opaqueId"},
        "logicalWidth": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000},
        "logicalHeight": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000},
        "devicePixelRatio": {"type": "number", "exclusiveMinimum": 0, "maximum": 8},
        "brightness": {"enum": ["light", "dark"]},
        "localeTag": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
        },
        "textScaleFactor": {"type": "number", "minimum": 0.5, "maximum": 4},
        "themeId": {"$ref": "#/$defs/opaqueId"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "variantSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variantId", "sourceId", "sourceDigest"],
      "properties": {
        "variantId": {"$ref": "#/$defs/opaqueId"},
        "sourceId": {"$ref": "#/$defs/opaqueId"},
        "sourceDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "variantManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "catalogDigest",
        "variants",
        "sources",
        "digest"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "VariantManifest"},
        "catalogDigest": {"$ref": "#/$defs/digest"},
        "variants": {
          "type": "array",
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/variant"}
        },
        "sources": {
          "type": "array",
          "maxItems": 500000,
          "items": {"$ref": "#/$defs/variantSource"}
        },
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "moduleId": {"$ref": "#/$defs/opaqueId"},
        "code": {"$ref": "#/$defs/opaqueId"},
        "severity": {"enum": ["info", "warning", "error"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "effectiveModuleState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moduleId",
        "state",
        "health",
        "effectiveCapabilities",
        "diagnostics"
      ],
      "properties": {
        "moduleId": {"$ref": "#/$defs/opaqueId"},
        "state": {
          "enum": [
            "disabled",
            "notPackaged",
            "unsupported",
            "dependencyMissing",
            "policyDenied",
            "starting",
            "ready",
            "degraded",
            "failed",
            "stopping",
            "stopped"
          ]
        },
        "health": {
          "enum": ["notApplicable", "unknown", "healthy", "degraded", "unhealthy"]
        },
        "effectiveCapabilities": {
          "type": "array",
          "items": {"$ref": "#/$defs/capability"}
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/diagnostic"}
        }
      }
    },
    "effectiveKitManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "resolvedPlanDigest",
        "modules",
        "commands",
        "rpcMethods",
        "studioContributions",
        "generatedAt",
        "digest"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "EffectiveKitManifest"},
        "resolvedPlanDigest": {"$ref": "#/$defs/digest"},
        "modules": {
          "type": "array",
          "items": {"$ref": "#/$defs/effectiveModuleState"}
        },
        "commands": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "rpcMethods": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "studioContributions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "generatedAt": {"$ref": "#/$defs/utcTime"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "providerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "providerModuleIds",
        "selectionPolicy",
        "settings"
      ],
      "properties": {
        "capability": {"$ref": "#/$defs/capability"},
        "providerModuleIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaqueId"}
        },
        "selectionPolicy": {"enum": ["orderedFirstAvailable", "all"]},
        "applicationId": {"$ref": "#/$defs/opaqueId"},
        "settings": {"type": "object"}
      }
    },
    "providerState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId",
        "displayName",
        "health",
        "supportedFidelities",
        "supportsCollection",
        "diagnostics"
      ],
      "properties": {
        "providerId": {"$ref": "#/$defs/opaqueId"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 512},
        "health": {
          "enum": ["notApplicable", "unknown", "healthy", "degraded", "unhealthy"]
        },
        "supportedFidelities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["structural", "simulated", "hostNative", "deviceAttested"]}
        },
        "supportsCollection": {"type": "boolean"},
        "diagnostics": {
          "type": "array",
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/diagnostic"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"providerId": {"const": "evidence.auto-preview"}}},
          "then": {"properties": {"supportedFidelities": {"const": ["structural"]}}}
        }
      ]
    },
    "visualEvidenceProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "status", "freshness", "diagnostics"],
      "properties": {
        "providerId": {"$ref": "#/$defs/opaqueId"},
        "scenarioId": {"$ref": "#/$defs/opaqueId"},
        "variantId": {"$ref": "#/$defs/opaqueId"},
        "evidenceDigest": {"$ref": "#/$defs/digest"},
        "artifactDigest": {"$ref": "#/$defs/digest"},
        "captureKey": {"$ref": "#/$defs/digest"},
        "executionFingerprintDigest": {"$ref": "#/$defs/digest"},
        "capturePolicyId": {"$ref": "#/$defs/opaqueId"},
        "status": {
          "enum": ["unbound", "collected", "missing", "failed", "unsupported", "policyDenied"]
        },
        "freshness": {"enum": ["missing", "fresh", "stale", "invalid"]},
        "fidelity": {"enum": ["structural", "simulated", "hostNative", "deviceAttested"]},
        "observedAt": {"$ref": "#/$defs/utcTime"},
        "artifactHandle": {"$ref": "#/$defs/resourceHandle"},
        "diagnostics": {
          "type": "array",
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/diagnostic"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "unbound"}}},
          "then": {
            "required": ["evidenceDigest"],
            "properties": {"scenarioId": false, "variantId": false}
          },
          "else": {"required": ["scenarioId", "variantId"]}
        },
        {
          "if": {"properties": {"status": {"const": "collected"}}},
          "then": {
            "required": [
              "evidenceDigest",
              "artifactDigest",
              "fidelity",
              "observedAt",
              "artifactHandle"
            ],
            "properties": {
              "freshness": {"enum": ["fresh", "stale"]},
              "artifactHandle": {
                "allOf": [
                  {"$ref": "#/$defs/resourceHandle"},
                  {
                    "properties": {
                      "mediaType": {"const": "image/png"},
                      "purpose": {"const": "visual-artifact"}
                    }
                  }
                ]
              }
            }
          },
          "else": {
            "if": {"properties": {"status": {"enum": ["missing", "failed", "unsupported", "policyDenied"]}}},
            "then": {
              "properties": {
                "artifactDigest": false,
                "artifactHandle": false
              }
            }
          }
        },
        {
          "if": {"properties": {"providerId": {"const": "evidence.auto-preview"}}},
          "then": {"properties": {"fidelity": {"const": "structural"}}}
        }
      ]
    },
    "consumerLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configFile",
        "configEnvironmentVariable",
        "contentRoot",
        "localConfigFile",
        "toolingEntrypoint",
        "commandAliases"
      ],
      "properties": {
        "configFile": {"type": "string", "minLength": 1, "maxLength": 4096},
        "configEnvironmentVariable": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"},
        "contentRoot": {"type": "string", "minLength": 1, "maxLength": 4096},
        "localConfigFile": {"type": "string", "minLength": 1, "maxLength": 4096},
        "toolingEntrypoint": {"type": "string", "minLength": 1, "maxLength": 4096},
        "commandAliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "displayName", "coreCompatibility", "defaultLayout", "commandAliases"],
      "properties": {
        "schemaVersion": {"const": 1},
        "id": {"$ref": "#/$defs/opaqueId"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 512},
        "coreCompatibility": {"type": "string", "pattern": "^\\^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "defaultLayout": {"$ref": "#/$defs/consumerLayout"},
        "commandAliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workspaceId", "displayName", "root", "target"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "workspaceId": {"$ref": "#/$defs/opaqueId"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 512},
        "root": {"type": "string", "minLength": 1, "maxLength": 4096},
        "target": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "applicationId", "title", "scenarioIds"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "applicationId": {"$ref": "#/$defs/opaqueId"},
        "title": {"type": "string", "minLength": 1, "maxLength": 2048},
        "scenarioIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/opaqueId"}
        }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "maxLength": 512},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "symbol": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "applicationId", "title", "sourceReferences"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "applicationId": {"$ref": "#/$defs/opaqueId"},
        "title": {"type": "string", "minLength": 1, "maxLength": 2048},
        "description": {"type": "string", "minLength": 1, "maxLength": 16384},
        "sourceReferences": {
          "type": "array",
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/sourceReference"}
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "journeyId", "from", "to"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "journeyId": {"$ref": "#/$defs/opaqueId"},
        "from": {"$ref": "#/$defs/opaqueId"},
        "to": {"$ref": "#/$defs/opaqueId"},
        "label": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "executionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenarioId", "targetId"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "scenarioId": {"$ref": "#/$defs/opaqueId"},
        "targetId": {"type": "string", "minLength": 1, "maxLength": 256},
        "launchProfileId": {"$ref": "#/$defs/opaqueId"},
        "checkpointId": {"$ref": "#/$defs/opaqueId"},
        "gatewayPresetId": {"$ref": "#/$defs/opaqueId"}
      },
      "oneOf": [
        {"required": ["launchProfileId"], "not": {"required": ["checkpointId"]}},
        {"required": ["checkpointId"], "not": {"required": ["launchProfileId"]}}
      ]
    },
    "reviewGuideStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "instruction", "observationCriteria", "scenarioId", "bindingId"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "instruction": {"type": "string", "minLength": 1, "maxLength": 4096},
        "observationCriteria": {"type": "string", "minLength": 1, "maxLength": 4096},
        "scenarioId": {"$ref": "#/$defs/opaqueId"},
        "bindingId": {"$ref": "#/$defs/opaqueId"}
      }
    },
    "reviewGuide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "applicationId", "title", "steps"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "applicationId": {"$ref": "#/$defs/opaqueId"},
        "title": {"type": "string", "minLength": 1, "maxLength": 2048},
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/reviewGuideStep"}
        }
      }
    },
    "catalogManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "distribution",
        "layout",
        "workspace",
        "applications",
        "journeys",
        "scenarios",
        "transitions",
        "executionBindings",
        "reviewGuides",
        "digest"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "CatalogManifest"},
        "distribution": {"$ref": "#/$defs/distribution"},
        "layout": {"$ref": "#/$defs/consumerLayout"},
        "workspace": {"$ref": "#/$defs/workspace"},
        "applications": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/application"}},
        "journeys": {"type": "array", "maxItems": 50000, "items": {"$ref": "#/$defs/journey"}},
        "scenarios": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/scenario"}},
        "transitions": {"type": "array", "maxItems": 500000, "items": {"$ref": "#/$defs/transition"}},
        "executionBindings": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/executionBinding"}},
        "reviewGuides": {"type": "array", "maxItems": 20000, "items": {"$ref": "#/$defs/reviewGuide"}},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "workspaceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "revision",
        "catalog",
        "variantManifest",
        "effectiveKitManifest",
        "providerBindings",
        "providers",
        "visualProjections",
        "moduleDiagnostics",
        "generatedAt",
        "digest"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "WorkspaceSnapshot"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "catalog": {"$ref": "#/$defs/catalogManifest"},
        "variantManifest": {"$ref": "#/$defs/variantManifest"},
        "effectiveKitManifest": {"$ref": "#/$defs/effectiveKitManifest"},
        "providerBindings": {
          "type": "array",
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/providerBinding"}
        },
        "providers": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/providerState"}
        },
        "visualProjections": {
          "type": "array",
          "maxItems": 500000,
          "items": {"$ref": "#/$defs/visualEvidenceProjection"}
        },
        "moduleDiagnostics": {
          "type": "array",
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/diagnostic"}
        },
        "generatedAt": {"$ref": "#/$defs/utcTime"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
