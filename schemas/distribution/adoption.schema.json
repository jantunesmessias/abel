{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jantunesmessias/abel/schemas/distribution/adoption",
  "title": "Adoption contracts",
  "oneOf": [
    {"$ref": "#/$defs/manifest"},
    {"$ref": "#/$defs/report"}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "fileRecord": {
      "type": "object",
      "required": ["path", "role", "contentDigest"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "role": {"type": "string", "minLength": 1},
        "contentDigest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": ["path", "role", "state"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "role": {"type": "string", "minLength": 1},
        "state": {
          "enum": ["planned", "ownedUnmodified", "modified", "missing", "preexisting"]
        },
        "expectedDigest": {"$ref": "#/$defs/digest"},
        "observedDigest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "required": ["schemaVersion", "kind", "distributionId", "files", "digest"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "AdoptionManifest"},
        "distributionId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileRecord"}},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "required": ["schemaVersion", "kind", "distributionId", "adopted", "canApply", "canDetach", "files"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "AdoptionReport"},
        "distributionId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "adopted": {"type": "boolean"},
        "canApply": {"type": "boolean"},
        "canDetach": {"type": "boolean"},
        "manifestDigest": {"$ref": "#/$defs/digest"},
        "files": {"type": "array", "items": {"$ref": "#/$defs/observation"}}
      },
      "additionalProperties": false
    }
  }
}
