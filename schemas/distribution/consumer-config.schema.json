{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jantunesmessias/abel/schemas/distribution/consumer-config",
  "title": "Consumer configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "content", "workspace", "applications", "kit"],
  "properties": {
    "schemaVersion": {"const": 2},
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": {"$ref": "#/$defs/relativePath"}
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "displayName": {"type": "string", "minLength": 1}
      }
    },
    "applications": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/opaqueId"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["root"],
        "properties": {
          "root": {"$ref": "#/$defs/relativePath"},
          "target": {"type": "string", "minLength": 1},
          "displayName": {"type": "string", "minLength": 1}
        }
      }
    },
    "launchProfiles": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/opaqueId"},
      "additionalProperties": {"$ref": "#/$defs/launchProfile"}
    },
    "kit": {"$ref": "#/$defs/kitSelection"}
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "moduleSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "settings": {"type": "object"}
      }
    },
    "providerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "providerModuleIds", "selectionPolicy"],
      "properties": {
        "capability": {"$ref": "#/$defs/capability"},
        "providerModuleIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaqueId"}
        },
        "selectionPolicy": {"enum": ["orderedFirstAvailable", "all"]},
        "applicationId": {"$ref": "#/$defs/opaqueId"},
        "settings": {"type": "object"}
      }
    },
    "launchProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationId",
        "platform",
        "command",
        "arguments",
        "workingDirectory"
      ],
      "properties": {
        "applicationId": {"$ref": "#/$defs/opaqueId"},
        "platform": {"enum": ["web", "androidEmulator"]},
        "command": {"type": "string", "minLength": 1},
        "arguments": {
          "type": "array",
          "items": {"type": "string"}
        },
        "workingDirectory": {"$ref": "#/$defs/relativePath"},
        "overlay": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "bootstrapPolicy": {
          "type": "object",
          "additionalProperties": {
            "enum": ["production", "overlay", "simulated", "blocked"]
          }
        }
      }
    },
    "kitSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modules"],
      "properties": {
        "profile": {"$ref": "#/$defs/opaqueId"},
        "modules": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/opaqueId"},
          "additionalProperties": {"$ref": "#/$defs/moduleSelection"}
        },
        "providerBindings": {
          "type": "array",
          "items": {"$ref": "#/$defs/providerBinding"}
        },
        "startupPolicy": {"$ref": "#/$defs/opaqueId"}
      }
    }
  }
}
