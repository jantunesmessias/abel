{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jantunesmessias/abel/schemas/distribution/distribution-release",
  "title": "Modular distribution release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "distribution",
    "releaseVersion",
    "coreVersion",
    "platform",
    "moduleCatalog",
    "modules",
    "profiles",
    "components",
    "entrypoints",
    "commandAliases",
    "files",
    "digest"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "kind": {"const": "DistributionReleaseManifest"},
    "distribution": {"$ref": "#/$defs/distributionDescriptor"},
    "releaseVersion": {"$ref": "#/$defs/semanticVersion"},
    "coreVersion": {"$ref": "#/$defs/semanticVersion"},
    "platform": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "moduleCatalog": {"$ref": "#/$defs/documentReference"},
    "modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/opaqueId"}
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/opaqueId"}
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cli"],
      "properties": {
        "cli": {"$ref": "#/$defs/relativePath"},
        "host": {"$ref": "#/$defs/relativePath"},
        "gateway": {"$ref": "#/$defs/relativePath"},
        "studio": {"$ref": "#/$defs/relativePath"}
      }
    },
    "commandAliases": {
      "type": "object",
      "propertyNames": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
      "additionalProperties": {"$ref": "#/$defs/relativePath"}
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file"}
    },
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "documentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configFile",
        "configEnvironmentVariable",
        "contentRoot",
        "localConfigFile",
        "toolingEntrypoint",
        "commandAliases"
      ],
      "properties": {
        "configFile": {"$ref": "#/$defs/relativePath"},
        "configEnvironmentVariable": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
        },
        "contentRoot": {"$ref": "#/$defs/relativePath"},
        "localConfigFile": {"$ref": "#/$defs/relativePath"},
        "toolingEntrypoint": {"$ref": "#/$defs/relativePath"},
        "commandAliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
        }
      }
    },
    "distributionDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "displayName",
        "coreCompatibility",
        "defaultLayout",
        "commandAliases",
        "moduleCatalog",
        "defaultProfileId"
      ],
      "properties": {
        "schemaVersion": {"const": 2},
        "id": {"$ref": "#/$defs/opaqueId"},
        "displayName": {"type": "string", "minLength": 1},
        "coreCompatibility": {
          "type": "string",
          "pattern": "^\\^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "defaultLayout": {"$ref": "#/$defs/layout"},
        "commandAliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
        },
        "moduleCatalog": {"$ref": "#/$defs/documentReference"},
        "defaultProfileId": {"$ref": "#/$defs/opaqueId"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "moduleIds"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "kind": {"enum": ["executable", "webAssets"]},
        "path": {"$ref": "#/$defs/relativePath"},
        "moduleIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaqueId"}
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "size", "executable", "role", "moduleIds"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "digest": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 0},
        "executable": {"type": "boolean"},
        "role": {"type": "string", "minLength": 1},
        "moduleIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaqueId"}
        }
      }
    }
  }
}
