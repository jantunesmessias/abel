{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jantunesmessias/abel/schemas/distribution/distribution-descriptor",
  "title": "Distribution descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "coreCompatibility",
    "defaultLayout",
    "commandAliases",
    "moduleCatalog",
    "defaultProfileId"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"$ref": "#/$defs/opaqueId"},
    "displayName": {"type": "string", "minLength": 1},
    "coreCompatibility": {
      "type": "string",
      "pattern": "^\\^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "defaultLayout": {"$ref": "#/$defs/layout"},
    "commandAliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
    },
    "moduleCatalog": {"$ref": "#/$defs/documentReference"},
    "defaultProfileId": {"$ref": "#/$defs/opaqueId"}
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "documentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configFile",
        "configEnvironmentVariable",
        "contentRoot",
        "localConfigFile",
        "toolingEntrypoint",
        "commandAliases"
      ],
      "properties": {
        "configFile": {"$ref": "#/$defs/relativePath"},
        "configEnvironmentVariable": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
        },
        "contentRoot": {"$ref": "#/$defs/relativePath"},
        "localConfigFile": {"$ref": "#/$defs/relativePath"},
        "toolingEntrypoint": {"$ref": "#/$defs/relativePath"},
        "commandAliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
        }
      }
    }
  }
}
