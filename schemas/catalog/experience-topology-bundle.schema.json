{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jantunesmessias/abel/schemas/catalog/experience-topology-bundle",
  "title": "ExperienceTopologyBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "catalogDigest",
    "topology",
    "layouts",
    "digest"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "ExperienceTopologyBundle"},
    "catalogDigest": {"$ref": "#/$defs/digest"},
    "topology": {"$ref": "#/$defs/topology"},
    "layouts": {
      "type": "array",
      "maxItems": 50000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/layout"}
    },
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 2048},
    "coordinate": {
      "type": "number",
      "minimum": -1000000,
      "maximum": 1000000
    },
    "extent": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000000
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "applicationId", "title", "projectionIds"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "applicationId": {"$ref": "#/$defs/opaqueId"},
        "title": {"$ref": "#/$defs/title"},
        "projectionIds": {
          "type": "array",
          "maxItems": 50000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaqueId"}
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "boardId",
        "applicationId",
        "title",
        "kind",
        "nodeInstanceIds",
        "edgeInstanceIds"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "boardId": {"$ref": "#/$defs/opaqueId"},
        "applicationId": {"$ref": "#/$defs/opaqueId"},
        "title": {"$ref": "#/$defs/title"},
        "kind": {
          "enum": ["journey", "inventory", "history", "comparison", "changeset"]
        },
        "journeyId": {"$ref": "#/$defs/opaqueId"},
        "nodeInstanceIds": {
          "type": "array",
          "maxItems": 500000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaqueId"}
        },
        "edgeInstanceIds": {
          "type": "array",
          "maxItems": 1000000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaqueId"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "journey"}}, "required": ["kind"]},
          "then": {"required": ["journeyId"]}
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "projectionId", "scenarioId"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "projectionId": {"$ref": "#/$defs/opaqueId"},
        "scenarioId": {"$ref": "#/$defs/opaqueId"},
        "comparisonRole": {"enum": ["canonical", "baseline", "candidate"]}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectionId",
        "transitionId",
        "fromNodeId",
        "toNodeId"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "projectionId": {"$ref": "#/$defs/opaqueId"},
        "transitionId": {"$ref": "#/$defs/opaqueId"},
        "fromNodeId": {"$ref": "#/$defs/opaqueId"},
        "toNodeId": {"$ref": "#/$defs/opaqueId"}
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "catalogDigest",
        "boards",
        "projections",
        "nodes",
        "edges",
        "digest"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "ExperienceTopologyManifest"},
        "catalogDigest": {"$ref": "#/$defs/digest"},
        "boards": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/board"}
        },
        "projections": {
          "type": "array",
          "maxItems": 50000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/projection"}
        },
        "nodes": {
          "type": "array",
          "maxItems": 500000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/node"}
        },
        "edges": {
          "type": "array",
          "maxItems": 1000000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/edge"}
        },
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "nodeFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeInstanceId", "x", "y", "width", "height"],
      "properties": {
        "nodeInstanceId": {"$ref": "#/$defs/opaqueId"},
        "x": {"$ref": "#/$defs/coordinate"},
        "y": {"$ref": "#/$defs/coordinate"},
        "width": {"$ref": "#/$defs/extent"},
        "height": {"$ref": "#/$defs/extent"},
        "groupId": {"$ref": "#/$defs/opaqueId"},
        "laneId": {"$ref": "#/$defs/opaqueId"}
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "x", "y", "width", "height"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "title": {"$ref": "#/$defs/title"},
        "x": {"$ref": "#/$defs/coordinate"},
        "y": {"$ref": "#/$defs/coordinate"},
        "width": {"$ref": "#/$defs/extent"},
        "height": {"$ref": "#/$defs/extent"}
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "x", "y", "width", "height"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "text": {"type": "string", "minLength": 1, "maxLength": 16384},
        "x": {"$ref": "#/$defs/coordinate"},
        "y": {"$ref": "#/$defs/coordinate"},
        "width": {"$ref": "#/$defs/extent"},
        "height": {"$ref": "#/$defs/extent"}
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": {"$ref": "#/$defs/coordinate"},
        "y": {"$ref": "#/$defs/coordinate"},
        "zoom": {"type": "number", "minimum": 0.05, "maximum": 64}
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "topologyDigest",
        "projectionId",
        "nodeFrames",
        "groups",
        "lanes",
        "annotations",
        "camera",
        "digest"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "ProjectionLayoutManifest"},
        "topologyDigest": {"$ref": "#/$defs/digest"},
        "projectionId": {"$ref": "#/$defs/opaqueId"},
        "nodeFrames": {
          "type": "array",
          "maxItems": 500000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nodeFrame"}
        },
        "groups": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/region"}
        },
        "lanes": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/region"}
        },
        "annotations": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/annotation"}
        },
        "camera": {"$ref": "#/$defs/camera"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
