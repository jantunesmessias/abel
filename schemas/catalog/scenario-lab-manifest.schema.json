{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jantunesmessias/abel/schemas/catalog/scenario-lab-manifest",
  "title": "ScenarioLabManifest",
  "$ref": "#/$defs/manifest",
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "operations"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "version": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaqueId"}
        }
      }
    },
    "capabilityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "version": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "booleanValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"const": "boolean"},
        "value": {"type": "boolean"}
      }
    },
    "choiceValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"const": "choice"},
        "value": {"$ref": "#/$defs/opaqueId"}
      }
    },
    "integerValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"const": "integer"},
        "value": {"type": "integer", "minimum": -1000000, "maximum": 1000000}
      }
    },
    "controlValue": {
      "oneOf": [
        {"$ref": "#/$defs/booleanValue"},
        {"$ref": "#/$defs/choiceValue"},
        {"$ref": "#/$defs/integerValue"}
      ]
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "displayName": {"$ref": "#/$defs/displayName"}
      }
    },
    "booleanDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "defaultValue"],
      "properties": {
        "kind": {"const": "boolean"},
        "defaultValue": {"type": "boolean"}
      }
    },
    "choiceDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "defaultValue", "choices"],
      "properties": {
        "kind": {"const": "choice"},
        "defaultValue": {"$ref": "#/$defs/opaqueId"},
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/choice"}
        }
      }
    },
    "integerRangeDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "defaultValue", "minimum", "maximum", "step"],
      "properties": {
        "kind": {"const": "integerRange"},
        "defaultValue": {"type": "integer", "minimum": -1000000, "maximum": 1000000},
        "minimum": {"type": "integer", "minimum": -1000000, "maximum": 1000000},
        "maximum": {"type": "integer", "minimum": -1000000, "maximum": 1000000},
        "step": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "controlDomain": {
      "oneOf": [
        {"$ref": "#/$defs/booleanDomain"},
        {"$ref": "#/$defs/choiceDomain"},
        {"$ref": "#/$defs/integerRangeDomain"}
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scenarioId",
        "displayName",
        "capability",
        "readOperationId",
        "writeOperationId",
        "domain"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "scenarioId": {"$ref": "#/$defs/opaqueId"},
        "displayName": {"$ref": "#/$defs/displayName"},
        "capability": {"$ref": "#/$defs/capabilityReference"},
        "readOperationId": {"$ref": "#/$defs/opaqueId"},
        "writeOperationId": {"$ref": "#/$defs/opaqueId"},
        "resetOperationId": {"$ref": "#/$defs/opaqueId"},
        "domain": {"$ref": "#/$defs/controlDomain"}
      }
    },
    "visualPolicyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "policyId"],
      "properties": {
        "kind": {"const": "visual"},
        "policyId": {"$ref": "#/$defs/opaqueId"}
      }
    },
    "semanticPolicyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "policyId"],
      "properties": {
        "kind": {"const": "semantic"},
        "policyId": {"$ref": "#/$defs/opaqueId"}
      }
    },
    "comparisonPolicyReference": {
      "oneOf": [
        {"$ref": "#/$defs/visualPolicyReference"},
        {"$ref": "#/$defs/semanticPolicyReference"}
      ]
    },
    "requiredEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scenarioId",
        "providerId",
        "fidelity",
        "variantId",
        "freshness",
        "allowedClassifications",
        "evidencePolicyId",
        "comparisonPolicy"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "scenarioId": {"$ref": "#/$defs/opaqueId"},
        "providerId": {"$ref": "#/$defs/opaqueId"},
        "fidelity": {"enum": ["structural", "simulated", "hostNative", "deviceAttested"]},
        "variantId": {"$ref": "#/$defs/opaqueId"},
        "freshness": {"const": "fresh"},
        "allowedClassifications": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["public", "internal", "sensitive"]}
        },
        "evidencePolicyId": {"$ref": "#/$defs/opaqueId"},
        "comparisonPolicy": {"$ref": "#/$defs/comparisonPolicyReference"}
      }
    },
    "assignControlOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenarioId", "kind", "controlId", "value"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "scenarioId": {"$ref": "#/$defs/opaqueId"},
        "kind": {"const": "assignControl"},
        "controlId": {"$ref": "#/$defs/opaqueId"},
        "value": {"$ref": "#/$defs/controlValue"}
      }
    },
    "resetControlOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenarioId", "kind", "controlId"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "scenarioId": {"$ref": "#/$defs/opaqueId"},
        "kind": {"const": "resetControl"},
        "controlId": {"$ref": "#/$defs/opaqueId"}
      }
    },
    "collectEvidenceOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenarioId", "kind", "evidenceRequirementId"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "scenarioId": {"$ref": "#/$defs/opaqueId"},
        "kind": {"const": "collectEvidence"},
        "evidenceRequirementId": {"$ref": "#/$defs/opaqueId"}
      }
    },
    "operation": {
      "oneOf": [
        {"$ref": "#/$defs/assignControlOperation"},
        {"$ref": "#/$defs/resetControlOperation"},
        {"$ref": "#/$defs/collectEvidenceOperation"}
      ]
    },
    "operationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "operationId", "timeoutMs", "timeoutOutcome"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "kind": {"const": "operation"},
        "operationId": {"$ref": "#/$defs/opaqueId"},
        "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 300000},
        "timeoutOutcome": {"enum": ["fail", "cancel"]}
      }
    },
    "executionBindingStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "bindingId", "timeoutMs", "timeoutOutcome"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "kind": {"const": "executionBinding"},
        "bindingId": {"$ref": "#/$defs/opaqueId"},
        "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 300000},
        "timeoutOutcome": {"enum": ["fail", "cancel"]}
      }
    },
    "scriptStep": {
      "oneOf": [
        {"$ref": "#/$defs/operationStep"},
        {"$ref": "#/$defs/executionBindingStep"}
      ]
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scenarioId",
        "displayName",
        "timeoutMs",
        "timeoutOutcome",
        "cancellationPolicy",
        "steps"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "scenarioId": {"$ref": "#/$defs/opaqueId"},
        "displayName": {"$ref": "#/$defs/displayName"},
        "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 1800000},
        "timeoutOutcome": {"enum": ["fail", "cancel"]},
        "cancellationPolicy": {"enum": ["immediate", "afterCurrentStep"]},
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/scriptStep"}
        }
      }
    },
    "scriptSucceededCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenarioId", "displayName", "kind", "scriptId"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "scenarioId": {"$ref": "#/$defs/opaqueId"},
        "displayName": {"$ref": "#/$defs/displayName"},
        "kind": {"const": "scriptSucceeded"},
        "scriptId": {"$ref": "#/$defs/opaqueId"}
      }
    },
    "evidenceAcceptedCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenarioId", "displayName", "kind", "evidenceRequirementId"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "scenarioId": {"$ref": "#/$defs/opaqueId"},
        "displayName": {"$ref": "#/$defs/displayName"},
        "kind": {"const": "evidenceAccepted"},
        "evidenceRequirementId": {"$ref": "#/$defs/opaqueId"}
      }
    },
    "controlEqualsCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenarioId", "displayName", "kind", "controlId", "expectedValue"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "scenarioId": {"$ref": "#/$defs/opaqueId"},
        "displayName": {"$ref": "#/$defs/displayName"},
        "kind": {"const": "controlEquals"},
        "controlId": {"$ref": "#/$defs/opaqueId"},
        "expectedValue": {"$ref": "#/$defs/controlValue"}
      }
    },
    "criterion": {
      "oneOf": [
        {"$ref": "#/$defs/scriptSucceededCriterion"},
        {"$ref": "#/$defs/evidenceAcceptedCriterion"},
        {"$ref": "#/$defs/controlEqualsCriterion"}
      ]
    },
    "visualPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "id", "maxChannelDelta", "maxChangedPixelRatio"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "VisualComparisonPolicy"},
        "id": {"$ref": "#/$defs/opaqueId"},
        "maxChannelDelta": {"type": "integer", "minimum": 0, "maximum": 255},
        "maxChangedPixelRatio": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "semanticPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "id", "maxChangedNodes", "ignoreBounds"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "SemanticComparisonPolicy"},
        "id": {"$ref": "#/$defs/opaqueId"},
        "maxChangedNodes": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "ignoreBounds": {"type": "boolean"}
      }
    },
    "humanApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenarioId", "reviewGuideId", "reviewGuideStepId", "scope"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "scenarioId": {"$ref": "#/$defs/opaqueId"},
        "reviewGuideId": {"$ref": "#/$defs/opaqueId"},
        "reviewGuideStepId": {"$ref": "#/$defs/opaqueId"},
        "scope": {"enum": ["scenarioRun", "evidenceSet"]}
      }
    },
    "artifactComparisonInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "artifactId"],
      "properties": {
        "kind": {"const": "artifact"},
        "artifactId": {"$ref": "#/$defs/opaqueId"}
      }
    },
    "evidenceComparisonInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "evidenceDigest", "provenanceDigest", "classification"],
      "properties": {
        "kind": {"const": "evidence"},
        "evidenceDigest": {"$ref": "#/$defs/digest"},
        "provenanceDigest": {"$ref": "#/$defs/digest"},
        "classification": {"enum": ["public", "internal", "sensitive"]}
      }
    },
    "requiredEvidenceComparisonInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "requiredEvidenceId"],
      "properties": {
        "kind": {"const": "requiredEvidence"},
        "requiredEvidenceId": {"$ref": "#/$defs/opaqueId"}
      }
    },
    "comparisonInput": {
      "oneOf": [
        {"$ref": "#/$defs/artifactComparisonInput"},
        {"$ref": "#/$defs/evidenceComparisonInput"},
        {"$ref": "#/$defs/requiredEvidenceComparisonInput"}
      ]
    },
    "comparisonBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenarioId", "requiredEvidenceId", "baseline", "candidate"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "scenarioId": {"$ref": "#/$defs/opaqueId"},
        "requiredEvidenceId": {"$ref": "#/$defs/opaqueId"},
        "baseline": {"$ref": "#/$defs/comparisonInput"},
        "candidate": {"$ref": "#/$defs/comparisonInput"}
      }
    },
    "supplementalArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scenarioId",
        "requiredEvidenceId",
        "role",
        "artifactDigest",
        "provenanceDigest",
        "classification"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueId"},
        "scenarioId": {"$ref": "#/$defs/opaqueId"},
        "requiredEvidenceId": {"$ref": "#/$defs/opaqueId"},
        "role": {
          "enum": ["comparisonBaseline", "comparisonCandidate", "diagnostic"]
        },
        "artifactDigest": {"$ref": "#/$defs/digest"},
        "provenanceDigest": {"$ref": "#/$defs/digest"},
        "classification": {"enum": ["public", "internal", "sensitive"]}
      }
    },
    "idArray": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/opaqueId"}
    },
    "nonEmptyIdArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/opaqueId"}
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "executionBindingIds",
        "controlIds",
        "operationIds",
        "scriptIds",
        "automatedAcceptanceCriterionIds",
        "requiredEvidenceIds",
        "comparisonBindingIds",
        "humanApprovalRequirementIds",
        "supplementalArtifactIds"
      ],
      "properties": {
        "scenarioId": {"$ref": "#/$defs/opaqueId"},
        "executionBindingIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaqueId"}
        },
        "controlIds": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaqueId"}
        },
        "operationIds": {"$ref": "#/$defs/idArray"},
        "scriptIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaqueId"}
        },
        "automatedAcceptanceCriterionIds": {"$ref": "#/$defs/idArray"},
        "requiredEvidenceIds": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaqueId"}
        },
        "comparisonBindingIds": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaqueId"}
        },
        "humanApprovalRequirementIds": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaqueId"}
        },
        "supplementalArtifactIds": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaqueId"}
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "catalogDigest",
        "appAdapterCapabilities",
        "controls",
        "operations",
        "scripts",
        "automatedAcceptanceCriteria",
        "requiredEvidence",
        "comparisonBindings",
        "visualComparisonPolicies",
        "semanticComparisonPolicies",
        "humanApprovalRequirements",
        "supplementalArtifacts",
        "plans",
        "digest"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "ScenarioLabManifest"},
        "catalogDigest": {"$ref": "#/$defs/digest"},
        "appAdapterCapabilities": {
          "type": "array",
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/capability"}
        },
        "controls": {
          "type": "array",
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/control"}
        },
        "operations": {
          "type": "array",
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/operation"}
        },
        "scripts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/script"}
        },
        "automatedAcceptanceCriteria": {
          "type": "array",
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/criterion"}
        },
        "requiredEvidence": {
          "type": "array",
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/requiredEvidence"}
        },
        "comparisonBindings": {
          "type": "array",
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/comparisonBinding"}
        },
        "visualComparisonPolicies": {
          "type": "array",
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/visualPolicy"}
        },
        "semanticComparisonPolicies": {
          "type": "array",
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/semanticPolicy"}
        },
        "humanApprovalRequirements": {
          "type": "array",
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/humanApproval"}
        },
        "supplementalArtifacts": {
          "type": "array",
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/supplementalArtifact"}
        },
        "plans": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/plan"}
        },
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
